# ─── Desi Hub — Umgebungsvariablen ───────────────────────
# Kopiere diese Datei nach .env.local und trage echte Werte ein.
# .env.local ist in .gitignore und wird NIE committet.

# ── Aktiv (lokal + Vercel) ──
APP_PASSWORD=            # Login-Passwort (Phase 1: durch echte Accounts ersetzt)
ADMIN_PASSWORD=         # Betreiber-Zugang zur /admin-Konsole — EIGENES, langes Passwort,
                        # NIE gleich APP_PASSWORD. Fehlt es, ist /admin komplett gesperrt.
SERPER_API_KEY=         # google.serper.dev — Web-Suche für Research & Trends

# ── KI-Anbieter (Provider-Layer, lib/llm.ts) ──
# Es reicht EINER, aber jeder gewählte Anbieter braucht seinen Key. Die Auswahl
# (welches Modell) trifft die Nutzerin in den Einstellungen; der Key bleibt serverseitig.
GROQ_API_KEY=           # Groq (Llama) — günstig & schnell, aktueller Standard
OPENAI_API_KEY=         # OpenAI (GPT-4o / mini)
GEMINI_API_KEY=         # Google Gemini (2.5 Flash / Pro)
ANTHROPIC_API_KEY=      # Anthropic Claude (Opus/Sonnet/Haiku) — OpenAI-Kompat-Endpoint
PERPLEXITY_API_KEY=     # Perplexity Sonar — Research-Modus mit Live-Web + Quellen

# ── Nur Vercel nötig (lokal optional; ohne sie fallen KV-Features sauber aus) ──
KV_REST_API_URL=        # Upstash Redis REST — Rate-Limiting, Cross-Device-Sync, Backups
KV_REST_API_TOKEN=

# ── Phase 1: Postgres + Auth (Neon) ──
DATABASE_URL=           # Neon „pooled" Connection (Host mit -pooler) — Runtime
DIRECT_URL=            # Neon direkte Connection (ohne -pooler) — Migrationen/drizzle-kit
AUTH_SECRET=           # Auth.js Sitzungs-Secret → openssl rand -base64 32
ENCRYPTION_KEY=        # Verschlüsselt kundeneigene KI-Keys (BYOK) → openssl rand -base64 32
                       # Ohne diesen Key ist „eigener KI-Schlüssel" deaktiviert (Operator-Key gilt).
# Login-Mails (Passwort-Reset & Einladung). Ohne RESEND_API_KEY werden Mails NICHT
# gesendet, sondern in die Server-Logs geschrieben (Dev) bzw. der Einladungs-Link
# in der Admin-Antwort zurückgegeben.
RESEND_API_KEY=        # resend.com API-Key (re_…)
AUTH_RESEND_FROM=      # verifizierter Absender, z. B. "Raumo <login@raumo.eu>"
# BLOB_READ_WRITE_TOKEN=   # (später) Vercel Blob für Medien

CRON_SECRET=           # schützt /api/cron/backup → openssl rand -base64 32
                       # Vercel sendet automatisch "Authorization: Bearer <CRON_SECRET>".

# ── Optional ──
PINTEREST_ENABLED=      # "true" NUR in Single-Tenant-Instanzen — sonst globales Token-Leck.
PINTEREST_APP_ID=       # Pinterest OAuth
PINTEREST_APP_SECRET=
PINTEREST_CALLBACK_URL=
